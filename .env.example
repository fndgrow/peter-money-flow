# Port the server listens on
PORT=3000
# Folder where the SQLite database file is stored (mount a persistent volume here in production)
DATA_DIR=./data
# Set to "true" when the app is served over HTTPS (required for installable PWA in production)
COOKIE_SECURE=false
# Optional: Cloudflare Turnstile "I am human" checkbox on the sign-in page.
# Create a widget at https://dash.cloudflare.com -> Turnstile for your domain, then paste both keys.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
